<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>horizon_api</RootNamespace>
    <UserSecretsId>a4019360-26d1-4be3-b93d-9548ad1a13e7</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <StartupObject></StartupObject>
	  <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Infrastructure\Accounts\**" />
    <Content Remove="Infrastructure\Accounts\**" />
    <EmbeddedResource Remove="Infrastructure\Accounts\**" />
    <None Remove="Infrastructure\Accounts\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.MySql" Version="9.0.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Grafana.OpenTelemetry" Version="1.14.0" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="OpenTelemetry" Version="1.20.0" />
    <PackageReference Include="Serilog" Version="4.4.1-dev-02447" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.1-dev-02312" />
    <PackageReference Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
