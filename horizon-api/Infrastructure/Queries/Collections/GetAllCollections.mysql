SELECT c.*, u.userName AS UserName
FROM PromptCollections c
JOIN Users u ON u.userId = c.userId
WHERE ((@scope = 'all' AND (c.userId = @userId OR c.`public` = 1))
   OR (@scope = 'owned' AND c.userId = @userId)
   OR (@scope = 'others' AND c.userId <> @userId AND c.`public` = 1))
  AND (@authorId IS NULL OR c.userId = @authorId)
  AND (@search IS NULL OR c.name LIKE CONCAT('%', REPLACE(REPLACE(REPLACE(@search, '\\', '\\\\'), '%', '\\%'), '_', '\\_'), '%'))
ORDER BY c.collectionId
LIMIT @pageSize OFFSET @offset;
