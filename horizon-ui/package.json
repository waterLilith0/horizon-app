{
  "name": "horizon-ui",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint --config configs/eslint.config.js .",
    "preview": "vite preview",
    "update-patches": "npx npm-check-updates --target patch -u && npm install",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" --ignore-path configs/.prettierignore --end-of-line lf",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" --ignore-path configs/.prettierignore --end-of-line lf",
    "deps:clean": "knip --fix",
    "api:generate": "orval --config orval.config.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@grafana/faro-react": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^9.3.1",
    "@uploadcn/core": "^0.1.3",
    "@uploadcn/react": "^0.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "horizon-blocklist": "^1.0.0",
    "jotai": "^3.0.1",
    "lightgallery": "^3.0.0",
    "motion": "^14.7.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-dropzone": "^20.1.4",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zxcvbn-ts": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@grafana/faro-rollup-plugin": "^0.13.2",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "msw": "^3.0.3",
    "orval": "^8.45.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
